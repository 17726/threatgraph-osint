# Backend runtime
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
SQLITE_DB_PATH=/app/data/threatgraph_osint.db
BACKEND_PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.13-slim

# LLM provider (never commit a real key)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_MAX_OUTPUT_TOKENS=16384
LLM_RELATION_REVIEW_PASSES=0
LLM_TRUST_ENV=false
CRAWLER_BASE_URL=http://crawler:8100
BACKEND_BASE_URL=http://backend:8000

# Neo4j enhancement layer
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_for_local_dev
NEO4J_DATABASE=neo4j

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
