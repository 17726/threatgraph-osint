{
  "name": "threatgraph-osint-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write \"../*.md\" \"../docs/**/*.md\" \"./src/**/*.{ts,tsx,css}\" \"./*.{html,json,ts}\"",
    "format:check": "prettier --check \"../*.md\" \"../docs/**/*.md\" \"./src/**/*.{ts,tsx,css}\" \"./*.{html,json,ts}\"",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.9.4",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
