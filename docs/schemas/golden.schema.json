{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threatgraph-osint.local/schemas/golden.schema.json",
  "title": "ThreatGraph Golden Evaluation Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_group", "doc_ids", "chunks", "notes"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "target_group": {
      "type": "string",
      "minLength": 1
    },
    "doc_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/golden_chunk"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "entity_type": {
      "type": "string",
      "enum": [
        "APT_GROUP",
        "ORGANIZATION",
        "PERSON",
        "MALWARE",
        "TOOL",
        "CVE",
        "TECHNIQUE",
        "TARGET",
        "COUNTRY",
        "REGION",
        "INDUSTRY",
        "TIME",
        "EVENT",
        "CAMPAIGN",
        "BEHAVIOR_PATTERN"
      ]
    },
    "relation_type": {
      "type": "string",
      "enum": [
        "USES",
        "TARGETS",
        "EXPLOITS",
        "ATTRIBUTED_TO",
        "AFFILIATED_WITH",
        "LOCATED_IN",
        "HAPPENED_AT",
        "PART_OF",
        "LEADS_TO",
        "RELATED_TO",
        "DISCOVERED_BY",
        "CAUSES",
        "HAS_BEHAVIOR"
      ]
    },
    "char_offset": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "golden_chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_id", "doc_id", "char_start", "char_end", "entities", "relations"],
      "properties": {
        "chunk_id": {
          "type": "string",
          "minLength": 1
        },
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "char_start": {
          "$ref": "#/$defs/char_offset"
        },
        "char_end": {
          "$ref": "#/$defs/char_offset"
        },
        "note": {
          "type": "string"
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/golden_entity"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/golden_relation"
          }
        }
      }
    },
    "golden_entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "aliases",
        "evidence_text",
        "char_start",
        "char_end",
        "canonical_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/entity_type"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence_text": {
          "type": "string",
          "minLength": 1
        },
        "char_start": {
          "$ref": "#/$defs/char_offset"
        },
        "char_end": {
          "$ref": "#/$defs/char_offset"
        },
        "canonical_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "golden_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head_name",
        "head_type",
        "relation_type",
        "tail_name",
        "tail_type",
        "evidence_text",
        "char_start",
        "char_end"
      ],
      "properties": {
        "head_name": {
          "type": "string",
          "minLength": 1
        },
        "head_type": {
          "$ref": "#/$defs/entity_type"
        },
        "relation_type": {
          "$ref": "#/$defs/relation_type"
        },
        "tail_name": {
          "type": "string",
          "minLength": 1
        },
        "tail_type": {
          "$ref": "#/$defs/entity_type"
        },
        "evidence_text": {
          "type": "string",
          "minLength": 1
        },
        "char_start": {
          "$ref": "#/$defs/char_offset"
        },
        "char_end": {
          "$ref": "#/$defs/char_offset"
        }
      }
    }
  }
}
