{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threatgraph-osint.local/schemas/candidate-audit.schema.json",
  "title": "ThreatGraph LLM Candidate Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "doc_id",
    "model_name",
    "prompt_version",
    "generated_at",
    "chunks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "doc_id": {
      "type": "string",
      "minLength": 1
    },
    "model_name": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunk_id", "rejected_entities", "rejected_relations"],
        "properties": {
          "chunk_id": {
            "type": "string",
            "minLength": 1
          },
          "rejected_entities": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "rejected_relations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
